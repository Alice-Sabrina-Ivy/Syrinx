# Test data (large WAV files; auto-downloaded by the relevant test)
# tests/dsp/data/ holds the Hillenbrand vowel corpus and IS committed
# (~19 MB total; well under GitHub's 50 MB warning threshold) so the
# real-speech accuracy tests run out of the box.
tests/ml/data/

# PTDB-TUG corpus subset (~117 MB audio + REF). Re-fetched on demand by
# scripts/fetch-ptdb-tug-subset.sh. The subdirectory's README.md and its
# local .gitignore (which excludes *.wav/*.f0/*.lar) ARE committed; only
# the audio + REF data files are excluded here.
tests/dsp/data/ptdb-tug/FEMALE/
tests/dsp/data/ptdb-tug/MALE/

# Python bytecode cache (generated when scripts/ Python tools run).
__pycache__/

# Claude Code harness scheduled-tasks lockfile (per-user runtime state).
.claude/scheduled_tasks.lock

# Local scratch directory for research PDFs / prototype scripts / draft
# PR bodies. Not part of the project; kept out of git.
build/

# Stale model-investigation artifacts from the audeering 6L + JaesungHuh
# perceived-voice gender experiments. The investigations are preserved
# on their own unmerged branches; these local copies in the build-output
# dir aren't part of any shipping artifact.
docs/audeering-6l-gender/
docs/jaesunghuh-gender/

# PENN Direction C investigation ONNX scaffolding. The investigation is
# preserved on the pitch-detection-penn branch; the ONNX files
# themselves are too large to commit on main.
scripts/penn-validation/
